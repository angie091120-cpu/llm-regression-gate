# Copy to .env (gitignored) and fill in real values locally, or export these
# as real environment variables in CI. Never commit a real key.

# Required for real-API runs (evalkit.run_eval, evalkit.judge). Not needed
# for `pytest -q` -- everything there is mocked (see AC1 in SPEC.md).
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: switch provider. Default is "anthropic".
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the model used for a given tier (see llm.py).
# LLM_CLASSIFIER_MODEL=claude-haiku-4-5
# LLM_JUDGE_MODEL=claude-sonnet-5

# Optional: eval engine tuning (see evalkit/run_eval.py, evalkit/diff.py).
# EVAL_CONCURRENCY=5
# WARN_THRESHOLD=0.03       # used only when --warn-threshold isn't passed
# CRITICAL_THRESHOLD=0.08   # used only when --critical-threshold isn't passed

# Optional: pricing overrides for cost_ledger.json (see evalkit/cost.py --
# the built-in defaults are Anthropic's official standard price as of
# 2026-09-14, see docs/DECISIONS.md D-005 and D-010; re-verify against
# https://www.anthropic.com/pricing before relying on them for real budget
# decisions if prices may have changed since).
# PRICE_CLAUDE_HAIKU_4_5_INPUT=1.00
# PRICE_CLAUDE_HAIKU_4_5_OUTPUT=5.00
# PRICE_CLAUDE_SONNET_5_INPUT=2.00
# PRICE_CLAUDE_SONNET_5_OUTPUT=10.00
